{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "323labs-com",
  "compatibility_date": "2026-10-19",
  "main": "src/worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "323labs.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
